// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Member {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  fullName        String
  fatherName      String?
  motherName      String?
  email           String         @unique
  password        String
  profileImage    String?
  phoneNumber     String?
  bloodGroup      BloodGroup     @default(UNKNOWN)
  bio             String?
  summary         String?
  status          UserStatus     @default(ACTIVE)
  role            Role           @default(USER)
  profession      String?
  village         String?
  currentLocation String?
  whatsappNumber  String?
  membershipType  MembershipType @default(PERMANENT)
  facebookProfile String?
  authProvider    AuthProvider   @default(EMAIL)
  emailVerified   Boolean        @default(false)
  phoneVerified   Boolean        @default(false)
  adminVerified   Boolean        @default(false)
  googleId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  chatSessions          ChatSession[]
  contributionsGiven    Contribution[] @relation("ContributionGiver")
  contributionsReceived Contribution[] @relation("ContributionReceiver")
  expensesSpent         Expense[]      @relation("ExpenseSpender")

  @@map("Member")
}

model Executive {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  slug              String        @unique // old "emon" id
  nameEn            String
  nameBn            String
  roleEn            String
  roleBn            String
  image             String?
  imagePublicId     String?
  villageEn         String
  villageBn         String // URL or path
  summaryEn         String
  summaryBn         String
  keyContributionEn String[]      @default([])
  keyContributionBn String[]      @default([])
  mottoEn           String?
  mottoBn           String?
  joiningYear       String
  isKeyLeader       Boolean       @default(false)
  type              ExecutiveType @default(COMMITTEE)
  order             Int           @default(0) // controls display order
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("Executive")
}

model ChatSession {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String?       @db.ObjectId
  member    Member?       @relation(fields: [memberId], references: [id])
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String      @db.ObjectId
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant | tool
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model ClubInfo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  category  String
  title     String
  content   String
  tags      String[] @default([])
  updatedAt DateTime @updatedAt
}

model Fund {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String         @unique
  category      FundCategory
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contributions Contribution[]
  expenses      Expense[]
}

model Contribution {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  fundId String @db.ObjectId
  fund   Fund   @relation(fields: [fundId], references: [id])

  amount     Int 
  method     ReceiveMethod 
  receivedAt DateTime 
  note       String?
  reference  String?

  giverMemberId String? @db.ObjectId
  giverMember   Member? @relation("ContributionGiver", fields: [giverMemberId], references: [id])
  giverName     String?

  receivedById String @db.ObjectId
  receivedBy   Member @relation("ContributionReceiver", fields: [receivedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fundId, receivedAt])
}

model Expense {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  fundId String @db.ObjectId
  fund   Fund   @relation(fields: [fundId], references: [id])
  amount     Int
  spentAt    DateTime
  spentOn    String
  note       String?
  receiptUrl String?

  spentById String? @db.ObjectId
  spentBy   Member? @relation("ExpenseSpender", fields: [spentById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fundId, spentAt])
}

enum ReceiveMethod {
  CASH
  BANK
  BKASH
  NAGAD
  OTHER
}

enum FundCategory {
  GPL
  SPORTS
  OWAJ
  IFTER_MAHFIL
  FOOTBALL
  OTHERS
}

enum ExecutiveType {
  PIONEER
  COMMITTEE
  ADMIN
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipType {
  PERMANENT
  PLAYER_QUOTA
}

enum AuthProvider {
  GOOGLE
  EMAIL
}
